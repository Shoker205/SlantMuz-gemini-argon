<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_large"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_liquid_glass"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_large_provider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SLANTMUZ STUDIO • 4×3 DECK"
            android:textColor="#FFA8E6CF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_large_fav_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♡ В избранное"
            android:textColor="#FFFFC6D9"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_large_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="SlantMuz Pastel Studio"
        android:textColor="#FFF8FAFC"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_large_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Выберите трек для синхронизации караоке и очереди"
        android:textColor="#FFCBD5E1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_large_lyric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="♪ Синхронный текст песни LRCLIB отобразится здесь"
        android:textColor="#FFC3B1E1"
        android:textSize="12sp"
        android:textStyle="italic" />

    <ProgressBar
        android:id="@+id/widget_large_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="40"
        android:progressTint="#FFA8E6CF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_large_prev_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFF8FAFC" />

        <ImageButton
            android:id="@+id/widget_large_play_btn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_widget_pill_button"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FF102A22" />

        <ImageButton
            android:id="@+id/widget_large_next_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFF8FAFC" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_large_queue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Далее в очереди: Jamendo 320kbps • Audius • Deezer HD"
        android:textColor="#FF94A3B8"
        android:textSize="11sp" />
</LinearLayout>
